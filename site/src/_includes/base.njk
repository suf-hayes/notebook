<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if pageTitle %}{{ pageTitle }} — {{ siteTitle }}{% else %}{{ siteTitle }}{% endif %}</title>
  {% if metaDescription %}<meta name="description" content="{{ metaDescription }}">{% endif %}
  <link rel="stylesheet" href="/fonts/fonts.css">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="page">
    <nav class="nav">
      <a href="/" class="nav-title">{{ siteTitle }}</a>
      <div class="nav-links">
        <a href="/">Essays</a>
        <a href="/about/">About</a>
      </div>
    </nav>
    {{ content | safe }}
  </div>
</body>
</html>
